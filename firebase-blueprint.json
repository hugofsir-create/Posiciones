{
  "entities": {
    "StockRecord": {
      "title": "StockRecord",
      "description": "Daily record of kilos stored",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of the record (YYYY-MM-DD)" },
        "kilos": { "type": "number", "description": "Amount in kilos" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["date", "kilos"]
    },
    "StockReport": {
      "title": "StockReport",
      "description": "Bi-weekly report of kilos stored",
      "type": "object",
      "properties": {
        "month": { "type": "string", "description": "Month of the report" },
        "period": { "type": "string", "description": "Period (1st or 2nd half)" },
        "total_kilos": { "type": "number" },
        "avg_kilos": { "type": "number" },
        "data_json": { "type": "string", "description": "JSON string of the daily records" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["month", "period", "total_kilos"]
    },
    "PalletRecord": {
      "title": "PalletRecord",
      "description": "Daily record of pallet positions (Bianchi)",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "positions": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "positions"]
    },
    "PalletReport": {
      "title": "PalletReport",
      "description": "Weekly report of pallet positions (Bianchi)",
      "type": "object",
      "properties": {
        "week_start": { "type": "string" },
        "week_end": { "type": "string" },
        "total_positions": { "type": "number" },
        "avg_positions": { "type": "number" },
        "data_json": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["week_start", "week_end", "total_positions"]
    },
    "CepasRecord": {
      "title": "CepasRecord",
      "description": "Daily record of positions (Cepas)",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "positions": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "positions"]
    },
    "CepasReport": {
      "title": "CepasReport",
      "description": "Monthly report of positions (Cepas)",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "total_positions": { "type": "number" },
        "avg_positions": { "type": "number" },
        "data_json": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["month", "total_positions"]
    },
    "EscorihuelaRecord": {
      "title": "EscorihuelaRecord",
      "description": "Daily record of positions (Escorihuela Gascón)",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "positions": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "positions"]
    },
    "EscorihuelaReport": {
      "title": "EscorihuelaReport",
      "description": "Monthly report of positions (Escorihuela Gascón)",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "total_positions": { "type": "number" },
        "avg_positions": { "type": "number" },
        "data_json": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["month", "total_positions"]
    },
    "LaRuralRecord": {
      "title": "LaRuralRecord",
      "description": "Daily record of positions (La Rural - Rutini Wines)",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "positions": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "positions"]
    },
    "LaRuralReport": {
      "title": "LaRuralReport",
      "description": "Monthly report of positions (La Rural - Rutini Wines)",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "total_positions": { "type": "number" },
        "avg_positions": { "type": "number" },
        "data_json": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["month", "total_positions"]
    },
    "AbastecimientoRecord": {
      "title": "AbastecimientoRecord",
      "description": "Record of received supply or release/return of pallets from/to a client",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date of movement (YYYY-MM-DD)" },
        "client": { "type": "string", "description": "Name of the client" },
        "remito": { "type": "string", "description": "Delivery note/Invoice number (Número de remito)" },
        "pallets": { "type": "number", "description": "Total quantity of pallets" },
        "pallets_arlog": { "type": "number", "description": "Quantity of Arlog/Estándar pallets" },
        "pallets_descartables": { "type": "number", "description": "Quantity of disposable (descartables) pallets" },
        "pallets_rotos": { "type": "number", "description": "Quantity of damaged/broken (rotos) pallets" },
        "type": { "type": "string", "enum": ["ingreso", "egreso"], "description": "Movement type: ingreso (entrada/recepción) or egreso (salida/devolución)" },
        "created_at": { "type": "string", "format": "date-time", "description": "Timestamp when registered" }
      },
      "required": ["date", "client", "remito", "pallets"]
    },
    "AgentSchedule": {
      "title": "AgentSchedule",
      "description": "Configurable automated agent task that schedules report generation, downloads, and recipient notifications",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Descriptive name of the automation agent" },
        "file_type": { "type": "string", "description": "Type of report/file to generate (abastecimientos, kilos, bianchi, cepas, escorihuela, la_rural, consolidado, backup)" },
        "file_format": { "type": "string", "enum": ["xlsx", "json"], "description": "Export format" },
        "date_range_preset": { "type": "string", "description": "Preset range of data (all, today, last_7_days, current_fortnight, current_month)" },
        "frequency": { "type": "string", "enum": ["daily", "weekdays", "weekly", "fortnightly", "monthly", "custom_days"], "description": "Execution frequency" },
        "days_of_week": { "type": "array", "items": { "type": "number" }, "description": "Days of week (0=Sunday to 6=Saturday)" },
        "day_of_month": { "type": "number", "description": "Day of the month for monthly frequency (1-31)" },
        "time": { "type": "string", "description": "Execution time in 24h format (HH:MM)" },
        "recipients": { "type": "array", "items": { "type": "string" }, "description": "List of recipient email addresses" },
        "email_subject": { "type": "string", "description": "Custom email subject line" },
        "email_body": { "type": "string", "description": "Custom notes or message body" },
        "auto_download": { "type": "boolean", "description": "Whether to auto-trigger file download on execution" },
        "status": { "type": "string", "enum": ["active", "paused"], "description": "Current status of the agent" },
        "last_run_at": { "type": "string", "description": "Timestamp of last execution" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "file_type", "frequency", "time", "recipients", "status"]
    },
    "AgentLog": {
      "title": "AgentLog",
      "description": "Log entry recording execution history of an automated agent",
      "type": "object",
      "properties": {
        "agent_id": { "type": "string", "description": "ID of the agent task" },
        "agent_name": { "type": "string", "description": "Name of the agent task" },
        "file_type": { "type": "string", "description": "Generated file type" },
        "file_name": { "type": "string", "description": "Name of downloaded/generated file" },
        "recipients": { "type": "array", "items": { "type": "string" }, "description": "Recipients assigned" },
        "executed_at": { "type": "string", "description": "Timestamp of execution" },
        "trigger_type": { "type": "string", "enum": ["scheduled", "manual"], "description": "How the task was triggered" },
        "status": { "type": "string", "enum": ["success", "failed"], "description": "Execution status" },
        "details": { "type": "string", "description": "Execution details / summary notes" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["agent_name", "file_type", "file_name", "executed_at", "status"]
    }
  },
  "firestore": {
    "/records": { "schema": "StockRecord", "description": "Collection of daily kilo records" },
    "/reports": { "schema": "StockReport", "description": "Collection of bi-weekly reports" },
    "/pallets": { "schema": "PalletRecord", "description": "Collection of daily pallet records" },
    "/pallet_reports": { "schema": "PalletReport", "description": "Collection of weekly pallet reports" },
    "/cepas": { "schema": "CepasRecord", "description": "Collection of daily cepas records" },
    "/cepas_reports": { "schema": "CepasReport", "description": "Collection of monthly cepas reports" },
    "/escorihuela": { "schema": "EscorihuelaRecord", "description": "Collection of daily Escorihuela Gascón records" },
    "/escorihuela_reports": { "schema": "EscorihuelaReport", "description": "Collection of monthly Escorihuela Gascón reports" },
    "/la_rural": { "schema": "LaRuralRecord", "description": "Collection of daily La Rural (Rutini Wines) records" },
    "/la_rural_reports": { "schema": "LaRuralReport", "description": "Collection of monthly La Rural (Rutini Wines) reports" },
    "/abastecimientos": { "schema": "AbastecimientoRecord", "description": "Collection of received pallet supplies" },
    "/agents": { "schema": "AgentSchedule", "description": "Collection of configured automation agents" },
    "/agent_logs": { "schema": "AgentLog", "description": "Collection of execution history logs for agents" }
  }
}
